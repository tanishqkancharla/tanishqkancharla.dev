#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

# Node 24 LTS satisfies the dependencies in package-lock.json.
node_version=24.11.0
if ! command -v node >/dev/null || [[ "$(node --version)" != "v${node_version}" ]]; then
  echo "Installing Node ${node_version}"
  SECONDS=0
  archive="node-v${node_version}-linux-$(uname -m | sed 's/x86_64/x64/; s/aarch64/arm64/').tar.xz"
  download_dir="$(mktemp -d)"
  trap 'rm -rf "$download_dir"' EXIT
  curl --fail --silent --show-error --location "https://nodejs.org/dist/v${node_version}/${archive}" -o "$download_dir/$archive"
  curl --fail --silent --show-error --location "https://nodejs.org/dist/v${node_version}/SHASUMS256.txt" -o "$download_dir/SHASUMS256.txt"
  (cd "$download_dir" && sha256sum --check --ignore-missing SHASUMS256.txt)
  sudo -n tar -xJf "$download_dir/$archive" -C /usr/local --strip-components=1
  echo "Node installed in ${SECONDS}s"
fi

echo "Installing dependencies with $(node --version) / npm $(npm --version)"
SECONDS=0
# Unlike npm ci, install preserves dependencies restored from a snapshot.
# --no-save leaves package.json and package-lock.json untouched.
npm install --no-save --include=dev --prefer-offline --no-audit --no-fund
echo "Dependencies ready in ${SECONDS}s"
